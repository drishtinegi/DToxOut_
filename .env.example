# Copy to .env (never commit .env). Used by docker-compose.yml
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Origin(s) users open in the browser
CORS_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
DOMAIN=app.example.com   # production overlay only
