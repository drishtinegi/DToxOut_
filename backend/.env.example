# DToxOut backend environment. Copy to backend/.env for local (non-Docker) dev.
APP_NAME=DToxOut
APP_ENV=development        # development | production  (production enforces strict checks)
DEBUG=false

HOST=0.0.0.0
PORT=8000

# PostgreSQL (required in production)
DATABASE_URL="postgresql://user:password@localhost:5432/dtoxout?schema=public"

# Auth - JWT_SECRET_KEY must be 32+ random chars in production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO
LOG_FORMAT=json            # keyvalue | json
CORS_ORIGINS="https://your-domain.com"
CORS_ALLOW_CREDENTIALS=true

# Reverse proxy / docs / HSTS
TRUSTED_PROXY_COUNT=1      # proxies in front of the API (0 = ignore X-Forwarded-For)
ENABLE_API_DOCS=false      # /docs is hidden in production unless true
HSTS_MAX_AGE=31536000

RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_AUTH="5/minute"
RATE_LIMIT_SCAN="10/minute"
RATE_LIMIT_SEARCH="30/minute"

UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
DELETE_TEMP_UPLOADS=true
RETAIN_UPLOADS=false
UPLOAD_RETENTION_HOURS=24

OCR_PROVIDER=tesseract     # mock | tesseract | paddle
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=10.0
OCR_MIN_CONFIDENCE=0.60

MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000

STORAGE_PROVIDER=local     # local | azure | s3
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="dtoxout-uploads"
S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
